# `pnpm build` must not re-run `pnpm install` first.
#
# The root pnpm-workspace.yaml currently carries an unfinished `allowBuilds` block
# (bigint-buffer, bufferutil, esbuild, utf-8-validate are all still set to the literal
# string "set this to true or false"), so every `pnpm install` exits 1 with
# ERR_PNPM_IGNORED_BUILDS. That file is owned by the workspace root, not by this app.
# Building should not depend on an install running anyway.
verify-deps-before-run=false
