  "cards": [
    {
      "dot": "cyan",
      "title": "Detection",
      "items": [
        "holdings and events both decode live Token-2022 config through core",
        "both also read packages/ledger's lifecycle.json for deadline and conversion-target data",
        "events builds the watched universe from PreStocks plus a filtered Jupiter search, then toIcs() renders the dated events as a calendar with 30/7/1-day reminders"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "sponsor re-derives every instruction before signing: fixed program allowlist, exactly one Jupiter instruction, no System program instruction",
        "sponsor may sign only as fee payer or ATA-rent funder, never as a token-owner signer",
        "packages/sponsor/check.mjs proves 3 attack variants are refused"
      ]
    },
    {
      "dot": "emerald",
      "title": "Verification",
      "items": [
        "every money-path package ships a check.mjs that recomputes its result against mainnet",
        "pnpm proof runs 5 of them as real subprocesses into apps/web/public/proof.json",
        "/proof shows each check's command, pass/fail and timestamp"
      ]
    }
  ]
